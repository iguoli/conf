[user]
    name = Guo, Li
    email = golotv@gmail.com
[color]
    # Enable colors in color-supporting terminals
    ui = auto
[color "branch"]
    # Blue on black is hard to read in git branch -vv: use magenta instead
    upstream = magenta
[core]
    # Use vim as default editor
    editor = vim
    # Don't paginate output by default
    pager = less -F -R -X
    # Global ignore file (not shared)
    excludefile = ~/.gitignore_global
[pager]
    # log = less
    # diff = less
[alias]
    # Command shortcuts
    ci = commit
    co = checkout
    st = status
    last = log -3
    unstage = reset HEAD --
    # Display more readable one line log
    logs = log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset' --date=short
[diff]
    # Use better descriptive initials c(ommit), i(ndex), w(ork) instead of a/b
    mnemonicPrefix = true
    # Show renames/moves as much
    renames = true
    # Use FileMerge as default diff tool when running `git diff-tool` on Mac
    tool = opendiff
    # Use WinMerge or VSCode as default diff tool on Windows
    # tool = winmerge
[merge]
    # Use FileMerge as default merge tool on Mac
    tool = opendiff
    # Use WinMerge or VSCode as default merge tool on Windows
    # tool = winmerge
[difftool]
    prompt = false
[difftool "winmerge"]
    cmd = 'C:/Program Files/WinMerge/WinMergeU.exe' -e "$LOCAL" "$REMOTE"
[mergetool "winmerge"]
    cdm = 'C:/Program Files/WinMerge/WinMergeU.exe' -e -u -dl "Base" -dr "Mine" "$LOCAL" "$REMOTE" "$MERGED"
[grep]
    break = true
    heading = true
    linNumber = true
    extendedRegexp = true
