# The settings for all hosts
# Keep the ssh connection alive
ServerAliveInterval 30

# Include other config file
Include conf.d/other_config

Host github.com
    HostName ssh.github.com
    Port 443
    User git
    # -S for socks5 proxy, -H for http proxy
    ProxyCommand connect -H 127.0.0.1:7890 %h %p

Host remotehost
    HostName remotehost.example.com
    # OpenSSH version 7.2 and earlier
    ProxyCommand ssh -W %h:%p jumphost
    # OpenSSH version 7.3 and later
    ProxyJump jumphost

Host jumphost
    Hostname jumphost.example.com
    IdentityFile ~/.ssh/id_rsa

Host *
    User username
    IdentityFile ~/.ssh/other_key
