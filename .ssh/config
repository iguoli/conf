Host github github.com
    HostName github.com
    Port 22
    User git
    IdentityFile ~/.ssh/li_rsa

Host ubuntu
    HostName 192.168.88.10
    Port 22
    User vagrant
    IdentityFile ~/vagrant/ubuntu1604/.vagrant/machines/default/virtualbox/private_key

Host test-centos
    Hostname 192.168.88.12
    Port 22
    User vagrant
    IdentityFile ~/vagrant/test-centos75/.vagrant/machines/default/virtualbox/private_key
    ProxyJump ubuntu 

Host chef-centos
    Hostname 192.168.88.11
    Port 22
    User vagrant
    ProxyCommand ssh -W %h:%p ubuntu
